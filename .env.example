# Supabase (für Admin, Buchungen, dynamische Inhalte)
#
# WICHTIG: Vite liest NUR .env, .env.local, .env.[mode].local — NICHT .env.example.
# → Kopiere diese Datei nach .env ODER lege .env.local an (siehe docs/local-admin-dev.env).
#
VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key

# Nur für lokales Script: npm run create-admin
# Niemals im Frontend verwenden, niemals committen!
SUPABASE_SERVICE_ROLE_KEY=

# Optional beim Anlegen des ersten Admins:
# ADMIN_EMAIL=admin@anatoly-mook.de
# ADMIN_PASSWORD=eigenes-sicheres-passwort

# --- Nur lokal (npm run dev): fester Admin-Testlogin ohne Supabase-User ---
# VITE_LOCAL_ADMIN_LOGIN=true
# VITE_LOCAL_ADMIN_EMAIL=admin@anatoly-mook.de
# VITE_LOCAL_ADMIN_PASSWORD=admin123
